rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{dataKey} {
      allow read, write: if true;
    }

    match /platform/{dataKey} {
      allow read, write: if true;
    }

    match /system/{document=**} {
      allow read, write: if true;
    }
  }
}
