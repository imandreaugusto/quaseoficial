rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function isCeo() {
    return isSignedIn() &&
      request.auth.token.email != null && (
        request.auth.token.email.lower() == 'andrejrcardoso93@gmail.com' ||
        request.auth.token.email.lower() == 'brazilianinaction@gmail.com' ||
        request.auth.token.email.lower() == 'brazilianinactionidiomas@gmail.com'
      );
  }

  match /databases/{database}/documents {
    match /users/{userId}/appData/{dataKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isCeo());
    }

    match /platform/{dataKey} {
      allow read: if isSignedIn();
      allow write: if isCeo();
    }

    match /system/{document=**} {
      allow read: if isSignedIn();
      allow write: if isCeo();
    }
  }
}
