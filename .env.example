# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TYPESAFE_API_KEY: Required for the Jev (System One) model. The Brazilian Space
# uses Jev to validate posts and replies; missing keys fail closed there.
# Phrase pre-validation for translation remains optional. Get a key at https://console.typesafe.ai/
TYPESAFE_API_KEY="your-typesafe-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Netlify / Supabase / Mercado Pago Environment Variables
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
ABACATEPAY_WEBHOOK_SECRET="generate-a-long-random-secret-and-store-it-only-in-provider-and-server-env"
ABACATEPAY_WEBHOOK_HMAC_KEY="provider-signature-key-store-only-in-server-env"
SUBSCRIPTION_PRICE_REAIS="10"
MERCADO_PAGO_TOKEN="APP_USR-your-production-or-test-token"

# Web Push server configuration. Keep the private key and cron secret server-side.
WEB_PUSH_PUBLIC_KEY="your-vapid-public-key"
WEB_PUSH_PRIVATE_KEY="your-vapid-private-key"
DAILY_REMINDER_CRON_SECRET="your-long-random-cron-secret"

# Action Street Module - 360° Street View
# Get free token at: https://www.mapillary.com/developer (requires registration)
# License: CC BY-SA 4.0 (must display attribution)
VITE_MAPILLARY_ACCESS_TOKEN="your-mapillary-access-token-here"

# MapLibre GL JS uses OpenFreeMap (https://openfreemap.org) - NO TOKEN REQUIRED
# Tiles are free and open-source, CC BY-SA 4.0
