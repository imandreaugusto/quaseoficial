# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TYPESAFE_API_KEY: Jev (System One) model, used to pre-validate student phrases
# before spending tokens on Gemini translation. Optional: validation is skipped
# (fails open) if this isn't set. Get a key at https://console.typesafe.ai/
TYPESAFE_API_KEY="your-typesafe-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Netlify / Supabase / Mercado Pago Environment Variables
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
ABACATEPAY_WEBHOOK_SECRET="generate-a-long-random-secret-and-store-it-only-in-provider-and-server-env"
SUBSCRIPTION_PRICE_REAIS="10"
MERCADO_PAGO_TOKEN="APP_USR-your-production-or-test-token"
